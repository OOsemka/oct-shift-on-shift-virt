# Rendered by the Shift-on-Shift Virt orchestrator next to the upstream Cilium
# chart output (cilium.yaml): what the chart leaves to the platform on
# OpenShift. Applies to the nested cluster only.
apiVersion: v1
kind: Namespace
metadata:
  name: cilium
  annotations:
    openshift.io/node-selector: ""
  labels:
    name: cilium
    openshift.io/run-level: "0"
    security.openshift.io/scc.podSecurityLabelSync: "false"
    pod-security.kubernetes.io/audit: privileged
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/warn: privileged
---
# The agent and operator run host-network and privileged (SELinux).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cilium-scc-privileged
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:openshift:scc:privileged
subjects:
- kind: ServiceAccount
  name: cilium
  namespace: cilium
- kind: ServiceAccount
  name: cilium-operator
  namespace: cilium
---
# OVN-Kubernetes treats host-network traffic as coming from namespaces with
# the label policy-group.network.openshift.io/host-network, and OpenShift's
# default NetworkPolicies rely on that (e.g. host-network routers -> the
# ingress canary on other nodes). Cilium sees such traffic as the host /
# remote-node entities, so allow it explicitly. enableDefaultDeny false: this
# only adds an allow and never puts a pod into default-deny. Needs the
# CiliumClusterwideNetworkPolicy CRD, which cilium-operator registers early
# in bootstrap; the installer retries custom manifests until it exists.
apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: sos-openshift-host-network
spec:
  endpointSelector: {}
  enableDefaultDeny:
    ingress: false
    egress: false
  ingress:
  - fromEntities:
    - host
    - remote-node
---
# OpenShift's default NetworkPolicies allow egress to the API servers with an
# ipBlock (e.g. dns-default: 0.0.0.0/0). The API servers are host-network on
# the masters, i.e. the host / remote-node / kube-apiserver identities, which
# Cilium matches with a CIDR only under policy-cidr-match-mode=nodes. That
# option is fragile: a cluster whose cilium-config was rewritten without it
# had every CoreDNS pod started afterwards never sync ("Failed to watch",
# "Policy denied ... -> host :6443"), so new services never resolved; and
# Isovalent's enterprise agent refuses to start with it. Allow the API
# servers by entity instead, independent of policy-cidr-match-mode and of
# anything that rewrites cilium-config. All endpoints: OpenShift adds such
# policies to more of its namespaces every release and the namespaces share
# no label; without an egress policy a pod reaches the API anyway, and the
# API's access control is RBAC, not the network. Port 6443 only (Cilium
# enforces after the service translation 172.30.0.1:443 -> <master>:6443).
# enableDefaultDeny false: this only adds an allow.
apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: sos-openshift-apiserver-egress
spec:
  endpointSelector: {}
  enableDefaultDeny:
    ingress: false
    egress: false
  egress:
  - toEntities:
    - kube-apiserver
    - host
    - remote-node
    toPorts:
    - ports:
      - port: "6443"
        protocol: TCP
---
# Cilium replaces kube-proxy (kubeProxyReplacement=true in cilium.yaml).
apiVersion: operator.openshift.io/v1
kind: Network
metadata:
  name: cluster
spec:
  deployKubeProxy: false
