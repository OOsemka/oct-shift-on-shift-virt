# Rendered by the Shift-on-Shift Virt orchestrator next to the upstream Cilium
# chart output (cilium.yaml): what the chart leaves to the platform on
# OpenShift. Applies to the nested cluster only.
apiVersion: v1
kind: Namespace
metadata:
  name: cilium
  annotations:
    openshift.io/node-selector: ""
  labels:
    name: cilium
    openshift.io/run-level: "0"
    security.openshift.io/scc.podSecurityLabelSync: "false"
    pod-security.kubernetes.io/audit: privileged
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/warn: privileged
---
# The agent and operator run host-network and privileged (SELinux).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cilium-scc-privileged
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: system:openshift:scc:privileged
subjects:
- kind: ServiceAccount
  name: cilium
  namespace: cilium
- kind: ServiceAccount
  name: cilium-operator
  namespace: cilium
---
# OVN-Kubernetes treats host-network traffic as coming from namespaces with
# the label policy-group.network.openshift.io/host-network, and OpenShift's
# default NetworkPolicies rely on that (e.g. host-network routers -> the
# ingress canary on other nodes). Cilium sees such traffic as the host /
# remote-node entities, so allow it explicitly. enableDefaultDeny false: this
# only adds an allow and never puts a pod into default-deny. Needs the
# CiliumClusterwideNetworkPolicy CRD, which cilium-operator registers early
# in bootstrap; the installer retries custom manifests until it exists.
apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: sos-openshift-host-network
spec:
  endpointSelector: {}
  enableDefaultDeny:
    ingress: false
    egress: false
  ingress:
  - fromEntities:
    - host
    - remote-node
---
# Cilium replaces kube-proxy (kubeProxyReplacement=true in cilium.yaml).
apiVersion: operator.openshift.io/v1
kind: Network
metadata:
  name: cluster
spec:
  deployKubeProxy: false
