# Nested-cluster side of the KubeVirt CSI driver (split mode). Rendered by the
# configure-storage Job with Python string.Template; placeholders come from its env.
# Derived from upstream kubevirt/csi-driver deploy/tenant with these changes:
#  - images: digests from the nested cluster's own release payload
#  - controller ClusterRole has NO privileged-SCC 'use' (its credential lives on the host)
#  - external-snapshotter-runner bound to the controller SA (kubevirt/csi-driver#398)
#  - no snapshot-sa: nothing runs as it in split mode
apiVersion: v1
kind: Namespace
metadata:
  name: kubevirt-csi-driver
  labels:
    app.kubernetes.io/managed-by: oct-shift-on-shift-virt
---
apiVersion: storage.k8s.io/v1
kind: CSIDriver
metadata:
  name: csi.kubevirt.io
  labels:
    app.kubernetes.io/managed-by: oct-shift-on-shift-virt
spec:
  attachRequired: true
  podInfoOnMount: true
  fsGroupPolicy: ReadWriteOnceWithFSType
---
